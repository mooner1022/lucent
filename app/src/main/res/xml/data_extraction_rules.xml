<?xml version="1.0" encoding="utf-8"?>
<!-- 토큰은 기기의 Keystore 키로 감싸 저장하므로 다른 기기로 옮겨도 쓸 수 없다. 기록과 설정도 클라우드 백업·기기 이전에 싣지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
