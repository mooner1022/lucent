<?xml version="1.0" encoding="utf-8"?>
<!-- 자동 완성 후보 한 개: 입력창 위에 놓이는 칩. 그림과 이름. 누르면 쓰던 `:글`이 `:name:`으로 바뀐다. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/chip_height"
    android:layout_marginEnd="@dimen/space_s"
    android:background="@drawable/bg_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m">

    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:layout_marginEnd="@dimen/space_s"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/name"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxWidth="@dimen/chip_text_max_width"
        android:maxLines="1"
        android:textColor="@color/ink"
        tools:text="루시아 웃음"/>
</LinearLayout>
