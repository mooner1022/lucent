<?xml version="1.0" encoding="utf-8"?>
<!--
  루시아가 알림에 답장하기 전에 묻는 시트. 머리 → 누구에게 보내는지 → 보낼 글(묶음 면) → 보내기 / 보내지 않기 → 안내 한 줄.
  보낼 글은 사용자의 이름으로 다른 사람에게 가므로 그대로(마크다운으로 풀지 않고) 보인다.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_m">

    <include
        android:id="@+id/head"
        layout="@layout/view_sheet_header"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/message"
                style="@style/Text.BodyS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_s"
                android:textColor="@color/ink_muted"
                tools:text="루시아가 카카오톡의 &apos;가족방&apos; 대화에 이렇게 답하려고 해요."/>

            <TextView
                android:id="@+id/quote"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_sheet_group"
                android:padding="@dimen/space_l"
                android:textIsSelectable="true"
                tools:text="지금 가는 중이야. 10분 뒤에 도착해!"/>

            <TextView
                android:id="@+id/send"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/reply_ask_send"/>

            <TextView
                android:id="@+id/skip"
                style="@style/Btn.Secondary"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/reply_ask_skip"/>

            <TextView
                android:id="@+id/note"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_horizontal"
                android:text="@string/reply_ask_note"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
