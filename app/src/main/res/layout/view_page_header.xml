<?xml version="1.0" encoding="utf-8"?>
<!-- 설정·연결 화면의 머리말: 대화 화면과 같은 하늘 띠에 뒤로 가기와 제목만. 글자색은 띠의 밝기를 따른다(PageSky). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <dev.mooner.lucent.ui.sky.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/headerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_xs">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"/>

        <TextView
            android:id="@+id/pageTitle"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
