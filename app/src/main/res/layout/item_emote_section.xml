<?xml version="1.0" encoding="utf-8"?>
<!-- 고르는 판의 분류 칩: 분류의 아이콘(목록의 그림, 있을 때만)과 이름. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/chip_height"
    android:layout_marginEnd="@dimen/space_xs"
    android:background="@drawable/bg_section_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:layout_marginEnd="@dimen/space_s"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/label"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/section_chip_text"
        tools:text="루시아"/>
</LinearLayout>
