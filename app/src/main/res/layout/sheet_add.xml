<?xml version="1.0" encoding="utf-8"?>
<!--
  "더하기"(입력창의 + 단추): 위에는 대화에 붙일 것(사진·파일), 아래에는 루시아가 어떻게 일할지(서버가 알려 준
  명령, 지금은 권한 모드). StarLight의 sheet_agent_add와 같은 짜임이다. 포함은 두 겹: 시트 → 타일 | 행 묶음 → 내용.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_xl">

    <include
        android:id="@+id/head"
        layout="@layout/view_sheet_header"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gutter">

        <LinearLayout
            android:id="@+id/photos"
            style="@style/SheetTile">

            <ImageView
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_image"
                app:tint="@color/sky_deep"/>

            <TextView
                style="@style/SheetTileLabel"
                android:text="@string/attach_photo"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/files"
            style="@style/SheetTile"
            android:layout_marginStart="@dimen/space_s">

            <ImageView
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_file"
                app:tint="@color/sky_deep"/>

            <TextView
                style="@style/SheetTileLabel"
                android:text="@string/attach_file"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 파일을 올릴 수 없을 때(연결 없음, 서버가 받지 않음) 그 이유. -->
    <TextView
        android:id="@+id/attachNote"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_s"
        android:visibility="gone"
        tools:text="연결되면 파일을 보낼 수 있어요"
        tools:visibility="visible"/>

    <!-- 서버가 알려 준 명령이 한 행씩 들어간다(AddSheet가 채운다). 없으면 묶음째 숨는다. -->
    <LinearLayout
        android:id="@+id/group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/gutter"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/bg_sheet_group"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"/>
</LinearLayout>
