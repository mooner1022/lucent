<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="@dimen/bubble_gap"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/gutter">

    <!-- 다른 기기에서 한 내 말이면 묶음의 첫 줄 위에 그 기기를 적는다(결정 0067). -->
    <TextView
        android:id="@+id/source"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_xs"
        android:visibility="gone"
        tools:text="데스크톱 앱에서"/>

    <LinearLayout
        android:id="@+id/files"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/text"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_user"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        android:textColor="@color/on_bubble_user"
        tools:text="내일 일정 알려 줘"/>

    <!-- 스티커: 말풍선 없이 그림 한 장(docs/emotes.md). 그릴 수 없으면 아래의 작은 상자가 대신 보인다. -->
    <ImageView
        android:id="@+id/sticker"
        android:layout_width="@dimen/sticker_size"
        android:layout_height="@dimen/sticker_size"
        android:scaleType="fitEnd"
        android:visibility="gone"
        tools:ignore="ContentDescription"/>

    <TextView
        android:id="@+id/stickerFallback"
        style="@style/Text.BodyS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:minHeight="@dimen/chip_height"
        android:paddingHorizontal="@dimen/space_m"
        android:textColor="@color/ink_muted"
        android:visibility="gone"
        tools:text="[스티커: 축하]"/>

    <!-- 함께 보낸 고른 글의 표지. 고른 글 자체는 남지 않는다(사양 5.6). -->
    <TextView
        android:id="@+id/context"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_xs"
        android:visibility="gone"
        tools:text="고른 글 120자 함께 보냄 · msedge.exe"/>

    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="오전 10:15"/>

        <TextView
            android:id="@+id/resend"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:fontFamily="@font/wantedsans_bold"
            android:text="@string/message_resend"
            android:textColor="@color/sky_deep"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/discard"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:fontFamily="@font/wantedsans_bold"
            android:text="@string/message_discard"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
