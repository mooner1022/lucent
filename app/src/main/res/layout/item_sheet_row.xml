<?xml version="1.0" encoding="utf-8"?>
<!-- 시트의 행: 아이콘 · 이름 · 지금 값 · 화살표. 누르면 그 값을 고르는 시트가 열린다. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SheetRow">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_shield"
        app:tint="@color/ink_muted"/>

    <TextView
        android:id="@+id/rowTitle"
        style="@style/RowTitle"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        tools:text="권한 모드"/>

    <TextView
        android:id="@+id/rowValue"
        style="@style/Text.BodyS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_faint"
        tools:text="기본"/>

    <ImageView
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        app:tint="@color/ink_faint"/>
</LinearLayout>
