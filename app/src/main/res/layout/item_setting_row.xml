<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 행: 묶음 면 안의 한 줄. 행 사이는 가는 선(SettingsActivity가 넣는다). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_s">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/RowTitle"
            tools:text="알림에 글 앞부분 보이기"/>

        <TextView
            android:id="@+id/rowValue"
            style="@style/RowBody"
            tools:text="꺼짐"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:layout_marginStart="@dimen/space_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        app:tint="@color/ink_faint"/>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/rowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:visibility="gone"/>
</LinearLayout>
