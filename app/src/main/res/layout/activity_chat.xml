<?xml version="1.0" encoding="utf-8"?>
<!--
  구조(포함 두 겹까지): 페이지 → 하늘 머리말 · 대화 목록 · 상황 자리 · 입력창.
  상황에 따라 바뀌는 곳은 ChatScene 하나가 정한다(docs/design.md 7장): 머리말의 하늘과 고리와 상태 줄, 상황 자리, 입력창.
  목록은 머리말 아래까지 이어지고(위 여백은 코드가 머리말 높이로 맞춘다) 머리말이 그 위에 떠서 둥근 아랫모서리가 보인다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 머리말의 하늘빛이 그 아래 종이에 옅게 번진다. 색은 지금 장면을 따른다(코드가 칠한다). -->
    <View
        android:id="@+id/glow"
        android:layout_width="0dp"
        android:layout_height="@dimen/sky_glow_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!--
      위아래 끝에서 말풍선이 스러진다(머리말 밑, 입력창 위). 더 굴릴 것이 없는 쪽은 스러지지 않는다.
      목록은 초점을 받을 수 있는데, 키로 초점이 오면 시스템이 목록 전체에 옅은 초점 표시를 덧칠한다(대화가 통째로 어두워진다).
      목록 자체는 누르는 것이 아니므로 그 표시를 끈다.
    -->
    <dev.mooner.lucent.ui.common.EdgeFadeRecyclerView
        android:id="@+id/messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:defaultFocusHighlightEnabled="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintBottom_toTopOf="@+id/bottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 빈 화면: 큰 초상과 한 줄. 인사는 커진 머리말이 하고, 아래 상황 자리에 꺼낼 만한 말이 놓인다. -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/emptyAvatar"
            android:layout_width="@dimen/avatar_hero"
            android:layout_height="@dimen/avatar_hero"
            android:contentDescription="@string/face_view"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_portrait_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Lucent.Image"/>

        <TextView
            android:id="@+id/emptyBody"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textColor="@color/ink_muted"
            tools:text="첫 인사를 건네 보세요."/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <dev.mooner.lucent.ui.sky.SkyView
            android:id="@+id/sky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/header_height"
                android:orientation="horizontal">

                <dev.mooner.lucent.ui.sky.PresenceAvatarView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/presence_size"
                    android:layout_height="@dimen/presence_size"
                    android:contentDescription="@string/face_view"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistant_name"/>

                    <!-- 상태 줄: 연결, 루시아가 지금 하는 일, 승인 대기. 키보드가 올라오면 사라진다. -->
                    <LinearLayout
                        android:id="@+id/statusRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/statusIcon"
                            android:layout_width="@dimen/dot"
                            android:layout_height="@dimen/dot"
                            android:importantForAccessibility="no"
                            android:src="@drawable/bg_status_dot"/>

                        <TextView
                            android:id="@+id/subtitle"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="연결됨 · 집 안"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/more"
                    style="@style/IconButton"
                    android:contentDescription="@string/menu_more"
                    android:src="@drawable/ic_more"/>
            </LinearLayout>

            <!-- 조용하다 돌아왔을 때만: 시간대 인사. 대화가 시작되면 사라지고 머리말이 다시 줄어든다. -->
            <TextView
                android:id="@+id/greeting"
                style="@style/Text.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_l"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                tools:text="좋은 저녁이에요"
                tools:visibility="visible"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 위로 올려 보는 중에 새 말이 오면 나타난다. -->
    <TextView
        android:id="@+id/jump"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chip_height"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/space_s"
        android:background="@drawable/bg_jump"
        android:drawablePadding="@dimen/space_s"
        android:elevation="@dimen/elevation_float"
        android:fontFamily="@font/wantedsans_bold"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_l"
        android:text="@string/chat_jump_latest"
        android:textColor="@color/sky_deep"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_arrow_down"
        app:drawableTint="@color/sky_deep"
        app:layout_constraintBottom_toTopOf="@+id/bottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"/>

    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--
          상황 자리: 지금 가장 필요한 것 하나만 놓인다(없으면 자리 자체가 사라진다).
          연결 끊김 → 다시 시도 / 화면 밖의 승인 대기 → 그 카드로 / 한동안 조용했음 → 꺼낼 만한 말.
        -->
        <FrameLayout
            android:id="@+id/slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/linkBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_linkbar"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_xs"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_m"
                    android:layout_height="@dimen/icon_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_link_off"
                    app:tint="@color/ink_muted"/>

                <TextView
                    android:id="@+id/linkText"
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    tools:text="연결이 끊겼어요 · 8초 뒤 다시 시도"/>

                <TextView
                    android:id="@+id/linkAction"
                    style="@style/Btn.Text"
                    android:text="@string/slot_retry_now"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dock"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/icon_m"
                    android:layout_height="@dimen/icon_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/gold_deep"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dockTitle"
                        style="@style/Text.BodyS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/wantedsans_bold"
                        tools:text="승인 대기 1건"/>

                    <TextView
                        android:id="@+id/dockSub"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ink_muted"
                        tools:text="메일 보내기"/>
                </LinearLayout>

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:fontFamily="@font/wantedsans_bold"
                    android:text="@string/dock_show"
                    android:textColor="@color/gold_deep"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/suggestScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/suggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </FrameLayout>

        <include
            android:id="@+id/composer"
            layout="@layout/view_composer"/>

        <include
            android:id="@+id/emotePanel"
            layout="@layout/view_emote_panel"
            android:visibility="gone"/>

        <!-- 토큰 문제: 입력창 자리에 행동이 나온다. -->
        <LinearLayout
            android:id="@+id/authBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_composer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_inset"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_inset"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/authText"
                style="@style/Text.BodyS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="토큰이 틀렸거나 취소됐어요"/>

            <TextView
                android:id="@+id/authAction"
                style="@style/Btn.Primary"
                android:layout_height="@dimen/control"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/banner_enter_token"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
