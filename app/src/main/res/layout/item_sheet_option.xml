<?xml version="1.0" encoding="utf-8"?>
<!-- 고르는 시트의 선택지 한 줄. 지금 값에는 표시가 붙는다. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SheetRow">

    <TextView
        android:id="@+id/optionTitle"
        style="@style/RowTitle"
        android:layout_width="0dp"
        android:layout_weight="1"
        tools:text="기본"/>

    <ImageView
        android:id="@+id/optionCheck"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:layout_marginStart="@dimen/space_s"
        android:contentDescription="@string/option_current"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/sky_deep"/>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/optionBusy"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:layout_marginStart="@dimen/space_s"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/sky_deep"
        app:indicatorSize="@dimen/icon_s"
        app:trackThickness="@dimen/stroke_emphasis"/>
</LinearLayout>
