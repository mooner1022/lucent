<?xml version="1.0" encoding="utf-8"?>
<!-- 입력창: radius_l 한 덩어리. 글을 쓰는 중(activated)이면 윤곽선이 하늘색으로 켜진다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <corners android:radius="@dimen/radius_l"/>
            <stroke android:width="@dimen/stroke_emphasis" android:color="@color/sky"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <corners android:radius="@dimen/radius_l"/>
            <stroke android:width="@dimen/stroke" android:color="@color/line"/>
        </shape>
    </item>
</selector>
