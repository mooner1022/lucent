<?xml version="1.0" encoding="utf-8"?>
<!-- 칩(제안, 첨부): 흰 면에 가는 선, radius_s. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/sky_wash">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <corners android:radius="@dimen/radius_s"/>
            <stroke android:width="@dimen/stroke" android:color="@color/line"/>
        </shape>
    </item>
</ripple>
